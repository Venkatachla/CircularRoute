APP_NAME=CircularRoute Backend
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:8080
# Canonical storage directories (defaults to backend/uploads and backend/outputs)
# Supports absolute paths or paths relative to the backend directory:
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
DATA_DIR=data

# Resend email settings (set EMAIL_ENABLED=true only when ready to send)
EMAIL_ENABLED=false
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=CircularRoute
