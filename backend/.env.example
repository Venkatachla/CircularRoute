APP_NAME=CircularRoute Backend
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173
# Canonical storage directories (defaults to backend/uploads and backend/outputs)
# Supports absolute paths or paths relative to the backend directory:
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
DATA_DIR=data

# SMTP Mail Settings (Optional - live email dispatching)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=circulars@univ.edu
SMTP_FROM_NAME=CircularRoute Notification System
SMTP_USE_TLS=true
